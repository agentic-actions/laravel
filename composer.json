{
    "name": "agentic-actions/laravel",
    "description": "One Action class for every surface of a Laravel app: web and JSON routes, the CLI, queued jobs, laravel/ai agents, MCP clients and typed TypeScript.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/agentic-actions/laravel",
    "support": {
        "issues": "https://github.com/agentic-actions/laravel/issues",
        "source": "https://github.com/agentic-actions/laravel",
        "security": "https://github.com/agentic-actions/laravel/security/policy",
        "docs": "https://github.com/agentic-actions/laravel/tree/main/docs"
    },
    "keywords": ["laravel", "actions", "ai", "agents", "tools", "mcp", "precognition", "typescript"],
    "authors": [
        {
            "name": "Hussam Abd",
            "email": "Hussam3bd@gmail.com",
            "homepage": "https://github.com/Hussam3bd"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "^2.2",
        "laravel/framework": "^12.62|^13.15",
        "laravel/mcp": "^1.0"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^3.3",
        "larastan/larastan": "^3.3.1",
        "laravel/ai": "^1.0",
        "laravel/passport": "^13.8",
        "laravel/pint": "^1.27",
        "laravel/sanctum": "^4.0",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "spatie/laravel-permission": "^6.0|^7.0|^8.0"
    },
    "suggest": {
        "laravel/ai": "^1.0 — expose actions as tools in your agents, with live copilot rows.",
        "laravel/passport": "^13.8 — OAuth sign-in for remote MCP clients such as Claude and ChatGPT connectors.",
        "laravel/sanctum": "^4.0 — per-effect token abilities on an api mount, and the default MCP guard.",
        "inertiajs/inertia-laravel": "^3.3 — flash results on Inertia visits, and #[WithPageContext].",
        "spatie/laravel-permission": "^6.0|^7.0|^8.0 — per-tenant permission scoping through AgenticActions\\Tenancy\\SpatieTeams."
    },
    "conflict": {
        "laravel/ai": "<1.0 || >=2.0"
    },
    "autoload": {
        "psr-4": {
            "AgenticActions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "lint": [
            "pint --format agent",
            "phpstan --memory-limit=-1"
        ],
        "test": "pest",
        "test:lint": "pint --test --format agent",
        "test:types": "phpstan --memory-limit=-1",
        "check": [
            "@composer test:lint",
            "@composer test:types",
            "@composer test"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.9.x-dev"
        },
        "laravel": {
            "providers": [
                "AgenticActions\\AgenticActionsServiceProvider"
            ]
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
